{
  "name": "wordloop-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "WordLoop - a casual word-chain game. React Native client.",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:ci": "node scripts/audit-gate.mjs"
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-safe-area-context": "^5.8.1",
    "react-native-screens": "^4.27.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "eslint-plugin-ft-flow": "^3.0.11"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "moduleNameMapper": {
      "^@app/(.*)$": "<rootDir>/src/app/$1",
      "^@navigation/(.*)$": "<rootDir>/src/navigation/$1",
      "^@screens/(.*)$": "<rootDir>/src/screens/$1",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@features/(.*)$": "<rootDir>/src/features/$1",
      "^@services/(.*)$": "<rootDir>/src/services/$1",
      "^@store/(.*)$": "<rootDir>/src/store/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^@types/(.*)$": "<rootDir>/src/types/$1",
      "^@constants/(.*)$": "<rootDir>/src/constants/$1",
      "^@theme/(.*)$": "<rootDir>/src/theme/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^@assets/(.*)$": "<rootDir>/src/assets/$1"
    }
  }
}
