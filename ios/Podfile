# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# WL-003: react-native-firebase resolves Firebase via Swift Package Manager
# by default, whose static-library products collide at link time under this
# project's default (non use_frameworks!) linkage — pod install fails with
# "SPM + static linkage is not supported" otherwise. Falling back to
# Firebase's traditional CocoaPods resolution is the surgical fix: switching
# to use_frameworks! :linkage => :dynamic instead would change how every pod
# in the project links, not just Firebase's.
$RNFirebaseDisableSPM = true

# WL-003: several Firebase pods (FirebaseCrashlytics, FirebaseSessions,
# FirebaseCoreInternal) are Swift and depend on Objective-C pods that don't
# define Clang modules (GoogleUtilities, GoogleDataTransport, nanopb).
# Without this, pod install fails with "cannot yet be integrated as static
# libraries". Global rather than per-pod modular_headers: the set of
# non-modular transitive dependencies is Firebase's to change between
# releases, and this project links no pod that modular headers would break.
use_modular_headers!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'WordLoop' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
